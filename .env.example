# LingoPath Environment Configuration Template
# Copy this file to .env or configure directly in the in-app Settings page

# Optional: Live OpenAI-compatible LLM endpoint (defaults to built-in educational tutor in demo mode)
LINGOPATH_AI_API_URL=https://api.openai.com/v1/chat/completions
LINGOPATH_AI_API_KEY=your_openai_or_compatible_api_key_here
LINGOPATH_AI_MODEL=gpt-4o-mini

# Optional: Supabase backend credentials (when integrating persistent cloud database)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here

# Application Configuration
LINGOPATH_DEMO_MODE=true
LINGOPATH_DEFAULT_LOCALE=th-en
